#!/bin/bash
# Test stand-in for herdr: only "config check" reaches the real binary ($REAL_HERDR).
echo "$*" >> "$HOME/.stub-log"
case "$1 $2" in
    "config check") exec "$REAL_HERDR" config check ;;
    "plugin list")
        fv='[]'; [[ -f "$HOME/.stub-plugins" ]] && fv=$(jq '.result.plugins' "$HOME/.stub-plugins")
        lk='[]'; [[ -f "$HOME/.stub-links" ]] && lk=$(cat "$HOME/.stub-links")
        jq -n --argjson a "$fv" --argjson b "$lk" '{result:{plugins:($a + $b)}}' ;;
    "plugin link" | "plugin unlink")   # .stub-links: the linked plugins; the file is gone when there are none
        lk='[]'; [[ -f "$HOME/.stub-links" ]] && lk=$(cat "$HOME/.stub-links")
        if [[ $2 == link ]]; then id=$(sed -n 's/^id = "\(.*\)"$/\1/p' "$3/herdr-plugin.toml"); root=$3; else id=$3; root=; fi
        lk=$(jq -c --arg id "$id" --arg p "$root" 'map(select(.plugin_id != $id)) + (if $p == "" then [] else [{plugin_id:$id, plugin_root:$p}] end)' <<<"$lk")
        if [[ $lk == '[]' ]]; then rm -f "$HOME/.stub-links"; else echo "$lk" > "$HOME/.stub-links"; fi ;;
    "plugin install")
        [[ -f "$HOME/.stub-fail-install" ]] && { echo "network error" >&2; exit 1; }
        ref=""; prev=""
        for a in "$@"; do [[ "$prev" == --ref ]] && ref="$a"; prev="$a"; done
        printf '{"result":{"plugins":[{"plugin_id":"herdr-file-viewer","source":{"resolved_commit":"%s"}}]}}\n' "$ref" > "$HOME/.stub-plugins" ;;
    "plugin uninstall") rm -f "$HOME/.stub-plugins" ;;
    "pane get") cat "$HOME/.stub-pane" ;;
    "workspace get") cat "$HOME/.stub-workspace" ;;
    "pane rename") ;;
    "pane report-metadata") ;;
    *) exit 1 ;;
esac
